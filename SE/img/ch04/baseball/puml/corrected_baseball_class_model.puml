@startuml
skinparam backgroundColor #f5f5f5
skinparam defaultFontName "Helvetica Neue", Arial, sans-serif
skinparam shadowing false
skinparam roundcorner 6
skinparam classAttributeIconSize 0
left to right direction

skinparam class {
  BackgroundColor #ffffff
  BorderColor #0b3c5d
  BorderThickness 2
  FontColor #0b3c5d
  FontStyle bold
  FontSize 14
  HeaderBackgroundColor #e8eff5
}

skinparam arrow {
  Color #0b3c5d
  FontColor #15803d
  FontStyle bold
  FontSize 13
}

class BaseballGame {
  - gameID: String
  - date: Date
  - homeScore: int
  - awayScore: int
  --
  + calculateWinner(): Team
  + printBoxScore(): void
}

class Team {
  - teamName: String
  - homeCity: String
  --
  + addPlayer(p: Player): void
  + getRoster(): List<Player>
}

class Player {
  - playerName: String
  - jerseyNumber: int
  - battingAverage: double
  --
  + swingBat(): void
  + pitchBall(): void
}

class Inning {
  - inningNumber: int
  - hits: int
  - runs: int
  --
  + getInningStats(): String
}

BaseballGame "1" o-- "2" Team : participates <
BaseballGame "1" *-- "9..*" Inning : contains >
Team "1" o-- "9..*" Player : employs >

@enduml
