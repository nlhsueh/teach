@startuml
skinparam backgroundColor #f5f5f5
skinparam defaultFontName "Helvetica Neue", Arial, sans-serif
skinparam shadowing false
left to right direction

skinparam actor {
  BackgroundColor #d9b310
  BorderColor #0b3c5d
  FontColor #0b3c5d
  FontStyle bold
  FontSize 12
}

skinparam usecase {
  BackgroundColor #ffffff
  BorderColor #328cc1
  BorderThickness 1.5
  FontColor #0b3c5d
  FontSize 12
}

skinparam rectangle {
  BackgroundColor #fdfdfd
  BorderColor #0b3c5d
  BorderThickness 2
  FontColor #0b3c5d
  FontStyle bold
  FontSize 13
}

skinparam arrow {
  Color #0b3c5d
  FontColor #333333
  FontSize 11
}

' Actors
actor "Customer" as Customer
actor "Restaurant Partner" as Restaurant
actor "Delivery Courier" as Courier
actor "Support Agent\n«Customer Service»" as Agent
actor "Payment Gateway\n«Supporting»" as Payment

rectangle "Food Delivery Platform Boundary" {
  ' Base Customer Use Cases
  usecase "Browse Menus & Dishes" as UC_Browse
  usecase "Place Food Order" as UC_PlaceOrder
  usecase "Track Delivery Live" as UC_Track
  
  ' Evolved Extensions (Solution 1)
  usecase "Schedule Future Order\n«extension»" as UC_Sched #e0f2fe
  usecase "Pool Group Cart\n«extension»" as UC_GroupCart #e0f2fe
  usecase "Apply Promo Voucher\n«extension»" as UC_Voucher
  
  ' Evolved Support Feature (Solution 1)
  usecase "Live Order Chat" as UC_Chat #fef3c7
  
  ' Restaurant & Operational Cases
  usecase "Manage Restaurant Menu" as UC_Menu
  usecase "Accept / Prepare Order" as UC_PrepOrder
  usecase "Process Payment" as UC_Payment
  usecase "Deliver Order to Customer" as UC_Deliver
}

' Customer Connections
Customer -- UC_Browse
Customer -- UC_PlaceOrder
Customer -- UC_Track
Customer -- UC_Chat

' Extensions (Dotted Arrows pointing to Base)
UC_Sched ..> UC_PlaceOrder : <<extend>>\n[scheduled]
UC_GroupCart ..> UC_PlaceOrder : <<extend>>\n[group_mode]
UC_Voucher ..> UC_PlaceOrder : <<extend>>

' Mandatory Include
UC_PlaceOrder ..> UC_Payment : <<include>>

' Live Chat multi-actor connection
UC_Chat -- Agent : <<assists>>
UC_Chat -- Courier : <<coordinates>>

' Supporting Actors
UC_Payment -- Payment
Restaurant -- UC_Menu
Restaurant -- UC_PrepOrder
Courier -- UC_Deliver
@enduml
