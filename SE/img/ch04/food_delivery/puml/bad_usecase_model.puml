@startuml
skinparam backgroundColor #f5f5f5
skinparam defaultFontName "Helvetica Neue", Arial, sans-serif
skinparam shadowing false
left to right direction

skinparam actor {
  BackgroundColor #d9b310
  BorderColor #0b3c5d
  FontColor #0b3c5d
  FontStyle bold
  FontSize 16
}

skinparam usecase {
  BackgroundColor #ffffff
  BorderColor #328cc1
  BorderThickness 2
  FontColor #0b3c5d
  FontStyle bold
  FontSize 15
}

skinparam package {
  BackgroundColor #fdfdfd
  BorderColor #0b3c5d
  BorderThickness 2.5
  FontColor #0b3c5d
  FontStyle bold
  FontSize 16
}

skinparam arrow {
  Color #0b3c5d
  FontColor #b91c1c
  FontStyle bold
  FontSize 14
}

actor "Customer" as Customer
actor "MySQL Database" as DB

rectangle "Food Delivery System Boundary" {
  actor "Chef" as Chef
  
  usecase "Enter Delivery Address" as UC_Address
  usecase "Click Submit Button" as UC_Submit
  usecase "Place Food Order" as UC_Order
  usecase "Process Payment" as UC_Pay
  
  Customer --> UC_Address
  UC_Address .> UC_Submit : then
  UC_Submit .> UC_Order : then
  
  UC_Pay ..> UC_Order : <<include>>
  UC_Order --> DB : writes SQL
  Chef --> UC_Order
}
@enduml
