@startuml
skinparam backgroundColor #f5f5f5
skinparam defaultFontName "Helvetica Neue", Arial, sans-serif
skinparam roundCorner 8
skinparam shadowing false

skinparam class {
  BackgroundColor #ffffff
  BorderColor #0b3c5d
  BorderThickness 1.5
  FontColor #0b3c5d
  HeaderBackgroundColor #e8eff5
  AttributeFontColor #1d2731
  AttributeFontSize 11
  OperationFontColor #1d2731
  OperationFontSize 11
}

skinparam arrow {
  Color #0b3c5d
  FontColor #333333
  FontSize 11
}

class Customer {
  - customerId: String
  - name: String
  - deliveryAddress: String
  + placeOrder(): Order
}

class Restaurant {
  - restaurantId: String
  - name: String
  - address: String
  + acceptOrder(): Boolean
}

class MenuItem {
  - itemId: String
  - name: String
  - price: Double
  - isAvailable: Boolean
}

class Order {
  - orderId: String
  - orderStatus: OrderStatus
  - totalAmount: Double
  + calculateTotal(): Double
  + assignCourier(c: Courier): void
}

class OrderItem {
  - quantity: Integer
  - itemPrice: Double
  - subtotal: Double
}

class Courier {
  - courierId: String
  - name: String
  - vehicleType: String
}

interface PaymentProcessor {
  + chargeCreditCard(amount: Double): Boolean
}

Restaurant "1" *-- "1..*" MenuItem : owns >
Order "1" *-- "1..*" OrderItem : consists of >
OrderItem "*" --> "1" MenuItem : references >
Customer "1" --> "*" Order : places >
Order "*" o-- "0..1" Courier : assigned to >
Order ..> PaymentProcessor : delegates >

@enduml
