@startuml
skinparam backgroundColor #f5f5f5
skinparam defaultFontName "Helvetica Neue", Arial, sans-serif
skinparam roundCorner 8
skinparam shadowing false

skinparam sequence {
  ArrowColor #0b3c5d
  LifeLineBorderColor #328cc1
  LifeLineBackgroundColor #e8eff5
  ParticipantBorderColor #0b3c5d
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #0b3c5d
  ParticipantFontStyle bold
  ActorBorderColor #0b3c5d
  ActorBackgroundColor #d9b310
  ActorFontColor #0b3c5d
}

autonumber

actor Customer
boundary CheckoutUI
control OrderCtrl
boundary StripeAPI
entity OrderEntity
queue KitchenQueue

Customer -> CheckoutUI: clickPayNow()
activate CheckoutUI

CheckoutUI -> OrderCtrl: submitOrder(cartItems, paymentInfo)
activate OrderCtrl

OrderCtrl -> StripeAPI: authorizeCharge(amount, token)
activate StripeAPI

alt Payment Approved
  StripeAPI --> OrderCtrl: chargeToken
  deactivate StripeAPI
  OrderCtrl -> OrderEntity: create(PLACED)
  activate OrderEntity
  deactivate OrderEntity
  OrderCtrl ->> KitchenQueue: orderPlacedEvent
  OrderCtrl --> CheckoutUI: orderSuccess(orderId)
  CheckoutUI --> Customer: displaySuccess(orderId)
else Payment Declined
  activate StripeAPI
  StripeAPI --> OrderCtrl: declinedError
  deactivate StripeAPI
  OrderCtrl --> CheckoutUI: paymentFailed()
  deactivate OrderCtrl
  CheckoutUI --> Customer: displayError()
  deactivate CheckoutUI
end

@enduml
